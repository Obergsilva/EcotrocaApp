// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusItem {
  DISPONIVEL
  NEGOCIANDO
  INDISPONIVEL
}

enum StatusProposta {
  PENDENTE
  ACEITA
  RECUSADA
  CANCELADA
}

// --------------------------------------------------------
// Model: Usuario - Representa quem usa o sistema
// --------------------------------------------------------
model Usuario {
  id           Int      @id @default(autoincrement())
  nomeCompleto String
  email        String   @unique
  senhaHash    String
  cidade       String?
  bairro       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relacionamentos
  itens     Item[] // Itens que o usuário cadastrou
  propostas Proposta[] // Propostas feitas por este usuário
}

// --------------------------------------------------------
// Model: Categoria - Para classificar os itens
// --------------------------------------------------------
model Categoria {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  descricao String?

  // Relacionamentos
  itens Item[]
}

// --------------------------------------------------------
// Model: Item - O que o usuário oferta no sistema
// --------------------------------------------------------
model Item {
  id                Int        @id @default(autoincrement())
  titulo            String
  descricao         String
  estadoConservacao String
  urlImagem         String?
  dataPublicacao    DateTime   @default(now())
  enderecoRetirada  String
  bairro            String?
  cidade            String?
  status            StatusItem @default(DISPONIVEL)

  // Relacionamentos
  dono      Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId Int

  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  categoriaId Int

  // Propostas relacionadas
  propostasOfertadas Proposta[] @relation("ItemOfertado")
  propostasDesejadas Proposta[] @relation("ItemDesejado")
}

// --------------------------------------------------------
// Model: Proposta - Representa a negociação entre usuários
// --------------------------------------------------------
model Proposta {
  id           Int            @id @default(autoincrement())
  dataProposta DateTime       @default(now())
  status       StatusProposta @default(PENDENTE)
  mensagem     String?

  // Relacionamentos
  autor   Usuario @relation(fields: [autorId], references: [id])
  autorId Int

  itemOfertado   Item @relation("ItemOfertado", fields: [itemOfertadoId], references: [id])
  itemOfertadoId Int

  itemDesejado   Item @relation("ItemDesejado", fields: [itemDesejadoId], references: [id])
  itemDesejadoId Int
}
