datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String
  itens Item[]
}

model Item {
  id        Int     @id @default(autoincrement())
  nome      String
  descricao String
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}
